# YouTube Data API v3 key (obrigatória)
YT_API_KEY=

# Porta do servidor (padrão: 3000)
PORT=3000

# Origens permitidas para CORS (separadas por vírgula, use '*' para permitir todas)
# Exemplo: https://meusite.com,https://app.meusite.com
# Deixe vazio ou use '*' para permitir todas as origens
ALLOWED_ORIGINS=*
